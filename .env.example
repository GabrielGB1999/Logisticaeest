# Copiar este archivo como .env y completar los valores:
#   cp .env.example .env

# =============================================================================
# OBLIGATORIO
# =============================================================================

# Clave para firmar las sesiones. Poner una cadena larga y al azar.
# El servidor NO arranca si falta. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# =============================================================================
# CUENTA DE ADMINISTRADOR
# =============================================================================
# Se usan sólo cuando la base de datos está vacía, es decir en el primer
# arranque. Después la cuenta se administra desde la aplicación.

ADMIN_USER=admin
ADMIN_PASSWORD=

# Recuperación de acceso. Poner en true y reiniciar para volver a dejar la
# contraseña de ADMIN_USER en el valor de ADMIN_PASSWORD (además reactiva la
# cuenta si estaba inactiva). Hay que volver a ponerlo en false y reiniciar:
# mientras esté en true pisa la contraseña en CADA arranque.
ADMIN_PASSWORD_RESET=false

# =============================================================================
# RED
# =============================================================================

# Puerto con el que se accede a la aplicación desde la red.
# (El puerto interno del contenedor es siempre 5000; se cambia sólo este.)
HOST_PORT=5000

# =============================================================================
# UBICACIÓN DE LOS ARCHIVOS
# =============================================================================
# DATA_DIR es la carpeta base de todo lo que hay que respaldar. Con docker
# compose ya viene configurada en /data y montada desde ./data, así que no hace
# falta tocar nada de esta sección.
#
# Las tres rutas siguientes cuelgan de DATA_DIR salvo que se definan aparte.
# Sirven para separar los archivos: por ejemplo la base en un disco dedicado y
# las planillas en una carpeta compartida de la red.
#
# Cuidado: son rutas DENTRO del contenedor. Para usar una carpeta del servidor
# hay que montarla antes en docker-compose.yml, en la sección volumes.
# Una ruta relativa se interpreta desde la raíz del proyecto.

# DATA_DIR=/data

# Archivo de la base de datos (ruta completa, con el nombre del archivo).
#   ejemplo: DB_FILE=/data/logistica.sqlite
# DB_FILE=

# Carpeta donde se dejan las planillas Excel para importar (alumnos.xlsx).
#   ejemplo: EXCEL_DIR=/data/planillas
# EXCEL_DIR=

# Carpeta donde se guardan los reportes de despacho generados.
#   ejemplo: REPORTS_DIR=/data/REPORTES_GUARDADOS
# REPORTS_DIR=

# =============================================================================
# EMAIL (opcional, para alertas por correo)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=tu_app_password
# ALERT_EMAIL_TO=admin@escuela.edu.ar
